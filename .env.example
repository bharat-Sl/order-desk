# Postgres connection string. On Vercel this is set automatically when you
# connect a Neon database from the project's Storage tab.
DATABASE_URL=

# Password for the admin panel (required on Vercel).
ADMIN_PASSWORD=

# Optional display settings
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Daily archive cleanup (Vercel Cron sends this as a bearer token)
CRON_SECRET=

# Receipt header (defaults are in lib/shop.ts; an empty value hides the line)
NEXT_PUBLIC_SHOP_NAME=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_FSSAI=
NEXT_PUBLIC_SHOP_GSTIN=
NEXT_PUBLIC_RECEIPT_TITLE=
